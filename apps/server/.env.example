# Copy to .env for local development.

# AI provider for the leftover transactions: "gemini" (free tier, default) or "claude".
AI_PROVIDER=gemini
# Free key from https://aistudio.google.com -> Get API key. Leave empty to run with rules only.
GEMINI_API_KEY=
# Only needed with AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
# Optional model override. Defaults: gemini-3.5-flash / claude-opus-5.
AI_MODEL=

PORT=3000
# Comma-separated list of allowed web origins.
CORS_ORIGIN=http://localhost:5173
# Upload limit in KB, and analyze requests per minute per IP.
MAX_UPLOAD_KB=1024
RATE_LIMIT_PER_MINUTE=10
