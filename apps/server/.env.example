# Copy to .env for local development.

# Claude API key. Leave empty to run with rules only (the leftovers stay uncategorized).
ANTHROPIC_API_KEY=
# Model for the leftover transactions.
AI_MODEL=claude-opus-5

PORT=3000
# Comma-separated list of allowed web origins.
CORS_ORIGIN=http://localhost:5173
# Upload limit in KB, and analyze requests per minute per IP.
MAX_UPLOAD_KB=1024
RATE_LIMIT_PER_MINUTE=10
